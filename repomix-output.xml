@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap');

:root {
  /* Colors - Light Mode */
  --bg-primary: #FAF9F6; /* Soft warm off-white / paper */
  --bg-secondary: #FFFFFF;
  --bg-tertiary: #F0EFEA;
  
  --text-primary: #1A1A1A; /* Deep charcoal */
  --text-secondary: #4A4A4A;
  --text-tertiary: #808080;

  /* Brand Accent */
  --brand-accent: #C85A3C; /* Warm terracotta */
  --brand-accent-hover: #A8492F;
  --brand-accent-light: rgba(200, 90, 60, 0.1);
  
  --border-light: rgba(0, 0, 0, 0.08);
  --border-strong: rgba(0, 0, 0, 0.2);

  /* Typography */
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
